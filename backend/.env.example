# Ambiente
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000"]

# Banco (Docker local). No Supabase: Project Settings > Database > Connection string
DATABASE_URL=postgresql+psycopg://cognita:cognita@localhost:5432/cognita

# Armazenamento de arquivos: local | supabase
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=data/uploads
MAX_UPLOAD_MB=25

# Chunking (caracteres; ~4 caracteres ≈ 1 token)
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# Supabase Storage (Etapa 2)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=documents

# Provedores — opções: fake | gemini | openai | groq | ollama
LLM_PROVIDER=fake
# Gemini: LLM_PROVIDER=gemini (vazio = gemini-3.5-flash-lite). Modelos 2.5 não aceitam contas novas.
LLM_MODEL=
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024
# Raciocínio dos modelos Gemini 3 (consome tokens de saída). Vazio = padrão; ex.: minimal, low
LLM_THINKING_LEVEL=

# RAG: trechos no contexto e similaridade mínima (vazio = sem filtro; ex.: 0.55)
RAG_TOP_K=5
RAG_MIN_SCORE=
EMBEDDING_PROVIDER=fake
EMBEDDING_MODEL=
# Gemini: EMBEDDING_PROVIDER=gemini e EMBEDDING_MODEL=gemini-embedding-001 (vazio = padrão)
# A dimensão precisa ser 768 (coluna vector(768) no banco).
EMBEDDING_DIMENSIONS=768

# Chaves (nunca commitar)
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
